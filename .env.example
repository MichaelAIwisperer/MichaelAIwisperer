# Coinbase Advanced Trade API (JWT-based)
# Your API key "name" and EC private key PEM string
COINBASE_API_KEY=
COINBASE_API_SECRET="""-----BEGIN EC PRIVATE KEY-----
# paste your PEM key here
-----END EC PRIVATE KEY-----"""

# Optional: override base URL (default: api.coinbase.com)
COINBASE_BASE_URL=api.coinbase.com
COINBASE_TIMEOUT_SECONDS=30

# News/Sentiment provider API keys (placeholders)
REUTERS_API_KEY=
WSJ_API_KEY=
SEEKING_ALPHA_API_KEY=

# Trading config
PRODUCT_ID=BTC-USD
PAPER_TRADING=true
TAKE_PROFIT_PCT=0.02
STOP_LOSS_PCT=0.01
MAX_POSITION_USD=100.0
